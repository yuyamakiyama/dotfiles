model = "gpt-6-astra"
model_reasoning_effort = "high"
model_verbosity = "low"
approval_policy = "on-request"
sandbox_mode = "workspace-write"
project_doc_max_bytes = 65536
project_doc_fallback_filenames = ["CLAUDE.md"]

[features]
hooks = true
multi_agent = true

[projects."{{ .chezmoi.homeDir }}"]
trust_level = "trusted"
{{ range default (list) .codexTrustedProjects }}
[projects."{{ . }}"]
trust_level = "trusted"
{{ end -}}

[mcp_servers.mobile]
command = "npx"
args = ["-y", "@mobilenext/mobile-mcp@latest"]

[mcp_servers.Notion]
url = "https://mcp.notion.com/mcp"

[[hooks.PreToolUse]]
matcher = "^Bash$"

[[hooks.PreToolUse.hooks]]
type = "command"
command = "bun ~/.codex/hooks/block-japanese-commit.ts"
timeout = 30
statusMessage = "Checking commit message language"

[[hooks.PostToolUse]]
matcher = "Edit|Write|apply_patch"

[[hooks.PostToolUse.hooks]]
type = "command"
command = "bun ~/.codex/hooks/flag-redundant-comments.ts"
timeout = 30
statusMessage = "Checking comments"

